# Production build settings (owner, 2026-10-19). Vite reads this file for `npm run build` only,
# never for the dev server. The GA4 Measurement ID is public (it shows in every page's code), so
# it lives here, and every build, including deploy/dreamhost.sh, carries it. The site still reports
# only from aressecurity.co (src/lib/analytics.ts), never from local tests or previews.
VITE_GA_ID=G-V4GCEJYB3L
