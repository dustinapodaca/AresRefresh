# Web3Forms public access key — restricted by allowed-origin on Web3Forms' side
# Get one at https://web3forms.com/ and add it to .env.local (gitignored).
VITE_WEB3FORMS_KEY=

# Google Analytics 4 Measurement ID (G-...), set in Netlify's environment variables.
# Reports only from aressecurity.co; leave empty locally. See docs/analytics.md.
VITE_GA_ID=
